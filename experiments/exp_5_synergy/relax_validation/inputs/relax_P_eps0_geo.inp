        &GLOBAL
          PROJECT relax_P_eps0_geo
          RUN_TYPE GEO_OPT
          PRINT_LEVEL MEDIUM
        &END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME relax_P_eps0_geo-1.restart
&END EXT_RESTART

        &MOTION
          &GEO_OPT
            TYPE MINIMIZATION
            OPTIMIZER BFGS
            MAX_ITER 300
            MAX_DR 3.0E-3
            MAX_FORCE 4.5E-4
            RMS_DR 1.5E-3
            RMS_FORCE 3.0E-4
          &END GEO_OPT

          &PRINT
            &TRAJECTORY
              FORMAT XYZ
              &EACH
                GEO_OPT 1
              &END EACH
            &END TRAJECTORY

            &RESTART
              &EACH
                GEO_OPT 10
              &END EACH
            &END RESTART
          &END PRINT
        &END MOTION

        &FORCE_EVAL
          METHOD Quickstep

          &DFT
            BASIS_SET_FILE_NAME BASIS_MOLOPT
            POTENTIAL_FILE_NAME GTH_POTENTIALS

            &MGRID
              CUTOFF 400
              REL_CUTOFF 50
            &END MGRID

            &QS
              METHOD GPW
              EPS_DEFAULT 1.0E-10
            &END QS

            &SCF
              SCF_GUESS RESTART
              EPS_SCF 1.0E-5
              MAX_SCF 300

              &OT
                MINIMIZER DIIS
                PRECONDITIONER FULL_ALL
              &END OT

              &OUTER_SCF
                MAX_SCF 40
                EPS_SCF 1.0E-5
              &END OUTER_SCF
            &END SCF

            &XC
              &XC_FUNCTIONAL PBE
              &END XC_FUNCTIONAL

              &VDW_POTENTIAL
                POTENTIAL_TYPE PAIR_POTENTIAL
                &PAIR_POTENTIAL
                  TYPE DFTD3
                  PARAMETER_FILE_NAME dftd3.dat
                  REFERENCE_FUNCTIONAL PBE
                &END PAIR_POTENTIAL
              &END VDW_POTENTIAL
            &END XC

            &PRINT
              &MULLIKEN
              &END MULLIKEN
            &END PRINT
          &END DFT

          &SUBSYS
            &CELL
      A 28.520000 0.000000 0.000000
      B 0.000000 28.520000 0.000000
      C 0.000000 0.000000 20.000000
      PERIODIC XYZ
    &END CELL


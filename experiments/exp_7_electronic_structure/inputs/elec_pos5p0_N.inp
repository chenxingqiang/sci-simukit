&GLOBAL
  PROJECT elec_pos5p0_N
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    
    &PRINT
      ! MO Eigenvalues - Key for HOMO-LUMO gap
      &MO
        EIGENVALUES .TRUE.
        OCCUPATION_NUMBERS .TRUE.
        NDIGITS 8
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
      
      ! MO Cube files for orbital visualization
      &MO_CUBES
        NHOMO 3
        NLUMO 3
        WRITE_CUBE .TRUE.
      &END MO_CUBES
      
      ! Total electron density
      &E_DENSITY_CUBE
        STRIDE 2 2 2
      &END E_DENSITY_CUBE
      
      ! Projected DOS
      &PDOS
        NLUMO 10
        COMPONENTS .TRUE.
      &END PDOS
      
      ! Mulliken population analysis
      &MULLIKEN
      &END MULLIKEN
      
      ! Hirshfeld charges
      &HIRSHFELD
      &END HIRSHFELD
    &END PRINT
  &END DFT
  
  &SUBSYS
    &CELL
      ABC 21.0000 21.0000 20.0000
      PERIODIC XYZ
    &END CELL
    
    &COORD
      N  2.320705  0.615996  2.666950
      C  3.263021  0.165586  1.630029
      C  1.394865  -0.331689  3.236323
      C  3.245414  -1.216426  1.201424
      C  3.347321  -1.530333  -0.199701
      N  3.382535  1.284251  0.673944
